{
	"name": "wari-ri",
	"version": "0.1.0",
	"private": true,
	"packageManager": "pnpm@11.28.4",
	"engines": {
		"node": "24"
	},
	"scripts": {
		"dev": "next dev --turbopack --port 3002",
		"build": "next build",
		"start": "next start",
		"lint": "biome check",
		"typecheck": "tsc --noEmit",
		"format": "biome format --write",
		"functions:build": "pnpm --filter functions run build",
		"firebase:login": "firebase login",
		"deploy:dev": "pnpm functions:build && firebase deploy --only functions,firestore:rules,firestore:indexes --project wari-ri-dev",
		"deploy:dev:functions": "pnpm functions:build && firebase deploy --only functions --project wari-ri-dev",
		"deploy:dev:firestore": "firebase deploy --only firestore:rules,firestore:indexes --project wari-ri-dev",
		"deploy:dev:rules": "firebase deploy --only firestore:rules --project wari-ri-dev",
		"deploy:dev:indexes": "firebase deploy --only firestore:indexes --project wari-ri-dev"
	},
	"dependencies": {
		"@mantine/core": "9.6.3",
		"@mantine/form": "9.6.3",
		"@mantine/hooks": "9.6.3",
		"@tabler/icons-react": "3.48.0",
		"firebase": "12.19.0",
		"next": "16.3.8",
		"react": "19.3.0",
		"react-dom": "19.3.0",
		"zod": "4.6.5"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.15",
		"@types/node": "24.19.1",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"firebase-tools": "15.32.1",
		"lefthook": "2.1.17",
		"postcss": "8.5.29",
		"postcss-preset-mantine": "1.18.0",
		"postcss-simple-vars": "7.0.1",
		"typescript": "7.0.2"
	}
}
