{
	"name": "wari-ri",
	"version": "0.1.0",
	"private": true,
	"packageManager": "pnpm@11.27.0",
	"engines": {
		"node": "24"
	},
	"scripts": {
		"dev": "next dev --turbopack --port 3002",
		"build": "next build",
		"start": "next start",
		"lint": "biome check",
		"typecheck": "tsc --noEmit",
		"format": "biome format --write",
		"functions:build": "pnpm --filter functions run build",
		"firebase:login": "firebase login",
		"deploy:dev": "pnpm functions:build && firebase deploy --only functions,firestore:rules,firestore:indexes --project wari-ri-dev",
		"deploy:dev:functions": "pnpm functions:build && firebase deploy --only functions --project wari-ri-dev",
		"deploy:dev:firestore": "firebase deploy --only firestore:rules,firestore:indexes --project wari-ri-dev",
		"deploy:dev:rules": "firebase deploy --only firestore:rules --project wari-ri-dev",
		"deploy:dev:indexes": "firebase deploy --only firestore:indexes --project wari-ri-dev"
	},
	"dependencies": {
		"@mantine/core": "8.3.18",
		"@mantine/form": "8.3.18",
		"@mantine/hooks": "8.3.18",
		"@tabler/icons-react": "3.46.0",
		"firebase": "12.19.0",
		"mantine-form-zod-resolver": "1.3.0",
		"next": "16.3.4",
		"react": "19.3.0",
		"react-dom": "19.3.0",
		"zod": "4.6.1"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.12",
		"@types/node": "24.13.4",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"firebase-tools": "15.29.0",
		"lefthook": "2.1.12",
		"postcss": "8.5.28",
		"postcss-preset-mantine": "1.18.0",
		"postcss-simple-vars": "7.0.1",
		"typescript": "5.9.3"
	}
}
