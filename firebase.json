{
	"apphosting": {
		"backendId": "wari-ri",
		"rootDir": "/",
		"ignore": [
			"node_modules",
			".git",
			"firebase-debug.log",
			"firebase-debug.*.log",
			"functions"
		]
	},
	"firestore": {
		"rules": "firestore.rules",
		"indexes": "firestore.indexes.json"
	},
	"emulators": {
		"firestore": {
			"port": 8085
		},
		"ui": {
			"enabled": false
		},
		"singleProjectMode": true
	},
	"functions": [
		{
			"source": "functions",
			"codebase": "default",
			"ignore": [
				"node_modules",
				".git",
				"firebase-debug.log",
				"firebase-debug.*.log",
				"*.local"
			],
			"predeploy": ["pnpm --dir \"$RESOURCE_DIR\" run build"]
		}
	]
}
